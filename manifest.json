{
  "name": "Hacker News: Mark All Read",
  "version": "1.64",
  "manifest_version": 3,
  "description": "Save time on HN by marking read the titles and comments you already scanned. And more.",
  "key": "",
  "permissions": [
    "identity",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://news.ycombinator.com/*"
  ],
  "oauth2": {
    "client_id": "467242308712-veejfintknjdbgtrmeom3b6gfim9kjbf.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.appdata"
    ]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://news.ycombinator.com/*"
      ],
      "js": [
        "jquery.min.js",
        "storageManager.js",
        "script.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "images/HNMarkAllRead-18.png",
        "styles.css"
      ],
      "matches": [
        "https://news.ycombinator.com/*"
      ]
    }
  ],
  "icons": {
    "128": "images/HNMarkAllRead.png"
  },
  "options_page": "options.html"
}
